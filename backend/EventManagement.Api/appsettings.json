{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "EventManagement.Api",
    "Audience": "EventManagement.Frontend",
    "SigningKey": "",
    "_SigningKeySource": "Set Jwt:SigningKey with .NET User Secrets locally or Jwt__SigningKey in the deployed environment.",
    "ExpiryMinutes": 75
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "AuthRateLimiting": {
    "Ip": {
      "Login": { "PermitLimit": 30, "WindowMinutes": 5 },
      "Registration": { "PermitLimit": 10, "WindowMinutes": 60 },
      "GoogleLogin": { "PermitLimit": 30, "WindowMinutes": 5 },
      "ForgotPassword": { "PermitLimit": 10, "WindowMinutes": 60 },
      "ResetPassword": { "PermitLimit": 20, "WindowMinutes": 60 }
    },
    "Account": {
      "Login": { "PermitLimit": 8, "WindowMinutes": 15 },
      "Registration": { "PermitLimit": 3, "WindowMinutes": 1440 },
      "GoogleLogin": { "PermitLimit": 20, "WindowMinutes": 15 },
      "ForgotPassword": { "PermitLimit": 3, "WindowMinutes": 60 },
      "ResetPassword": { "PermitLimit": 5, "WindowMinutes": 15 }
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Payments": {
    "Provider": "Paystack",
    "PendingMinutes": 15,
    "Paystack": {
      "SecretKey": "",
      "_SecretKeySource": "Set PAYSTACK_SECRET_KEY in User Secrets or the deployed environment. Never commit it."
    }
  },
  "Tickets": {
    "SigningKey": "",
    "_SigningKeySource": "Set QR_SIGNING_KEY to a random secret of at least 32 characters. Keep it stable or existing tickets become invalid."
  },
  "Certificates": {
    "Bucket": "certificates",
    "SignedUrlMinutes": 5,
    "TemplateVersion": 1
  },
  "Google": {
    "ClientId": "",
    "_ClientIdSource": "Set Google:ClientId with .NET User Secrets locally or Google__ClientId in the deployed environment."
  },
  "Email": {
    "Provider": "Mailtrap",
    "Api": {
      "Token": "",
      "SenderEmail": "",
      "SenderName": "Campus Events"
    },
    "Gmail": {
      "Username": "",
      "AppPassword": "",
      "SenderEmail": "",
      "SenderName": "Campus Events",
      "_AppPasswordSource": "Use a Google App Password from User Secrets or GMAIL_APP_PASSWORD. Never use the account password."
    },
    "Reminders": {
      "LeadTimeHours": 24,
      "CheckIntervalMinutes": 60
    },
    "Outbox": {
      "PollIntervalSeconds": 15,
      "BatchSize": 50,
      "ClaimLeaseMinutes": 10,
      "MaxAttempts": 8,
      "RetentionSweepMinutes": 60,
      "DeliveredRetentionDays": 30,
      "FailedRetentionDays": 90
    }
  },
  "Supabase": {
    "Url": "",
    "ServiceRoleKey": "",
    "_ServiceRoleKeySource": "Set Supabase:ServiceRoleKey with User Secrets locally or SUPABASE_SERVICE_ROLE_KEY in the deployed environment. Never expose it to Vite."
  },
  "Images": {
    "UploadRateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 60
    },
    "Cleanup": {
      "IntervalMinutes": 60,
      "PendingRetentionHours": 24,
      "ClaimLeaseMinutes": 10,
      "BatchSize": 50,
      "MaxAttempts": 8
    }
  },
  "DataRetention": {
    "SweepIntervalHours": 24,
    "BookingRequests": {
      "ClosedRetentionDays": 90
    },
    "AdminAuditLogs": {
      "RetentionDays": 365
    }
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": "",
    "Name": "System Administrator"
  },
  "DemoData": {
    "Enabled": false,
    "_EnabledSource": "Set DemoData__Enabled=true only for an intentional, idempotent demonstration-data seed.",
    "Password": "",
    "_PasswordSource": "Set DemoData__Password only in User Secrets or the deployed environment; never commit it."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
