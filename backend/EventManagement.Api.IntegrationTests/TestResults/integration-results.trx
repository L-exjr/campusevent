      UPDATE "ImageUploads"
      SET "Status" = 'DeletePending', "AvailableAt" = @p0
      WHERE "Status" = 'Pending' AND "CreatedAt" &lt; @p1;
      WITH candidates AS (
          SELECT "Id"
          FROM "ImageUploads"
          WHERE ("Status" = 'DeletePending' AND "AvailableAt" &lt;= @p2)
