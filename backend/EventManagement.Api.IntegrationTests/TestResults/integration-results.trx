      Executed DbCommand (5ms) [Parameters=[@p1='?' (DbType = Int32), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT e0."Id", e0."Title", e0."Description", e0."Date", e0."Location", e0."Capacity", e0."Category", e0."OrganizerId", u."Name", (
          SELECT count(*)::int
          FROM "EventRegistrations" AS e1
          WHERE e0."Id" = e1."EventId"), e0."CreatedAt", e0."ImageUrl", e0."IsPublished", e0."Version", e0."PriceMinor", e0."Currency", e0."Format", e0."MeetingUrl", e0."SalesStartsAt", e0."SalesEndsAt"
      FROM (
          SELECT e."Id", e."Capacity", e."Category", e."CreatedAt", e."Currency", e."Date", e."Description", e."Format", e."ImageUrl", e."IsPublished", e."Location", e."MeetingUrl", e."OrganizerId", e."PriceMinor", e."SalesEndsAt", e."SalesStartsAt", e."Title", e."Version"
          FROM "Events" AS e
          WHERE e."IsPublished"
          ORDER BY e."Date", e."Id"
          LIMIT @p1 OFFSET @p
      ) AS e0
      INNER JOIN "Users" AS u ON e0."OrganizerId" = u."Id"
      ORDER BY e0."Date", e0."Id"
