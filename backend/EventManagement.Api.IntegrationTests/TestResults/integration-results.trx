      Executed DbCommand (2ms) [Parameters=[@email='?'], CommandType='Text', CommandTimeout='30']
      SELECT u."Id", u."AuthProvider", u."CreatedAt", u."Email", u."GoogleSubject", u."ImageObjectKey", u."ImageUrl", u."IsActive", u."Name", u."PasswordHash", u."Role", u."SessionVersion"
