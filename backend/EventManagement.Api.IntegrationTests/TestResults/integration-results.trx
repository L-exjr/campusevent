      Executed DbCommand (2ms) [Parameters=[@claimId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT e."Id", e."AggregateId", e."AttemptCount", e."AvailableAt", e."ClaimedAt", e."ClaimedBy", e."CreatedAt", e."IdempotencyKey", e."Kind", e."LastError", e."LastRetriedAt", e."LifetimeAttemptCount", e."ManualRetryCount", e."PayloadJson", e."SentAt", e."Status"
      FROM "EmailOutboxMessages" AS e
      WHERE e."ClaimedBy" = @claimId AND e."Status" = 'Processing'
      ORDER BY e."CreatedAt"
