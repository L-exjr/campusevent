      SET "PayloadJson" = NULL
      WHERE message."Kind" = @p0
        AND message."PayloadJson" IS NOT NULL
        AND NOT EXISTS (
            SELECT 1
            FROM "PasswordResetTokens" AS token
            INNER JOIN "Users" AS account ON account."Id" = token."UserId"
