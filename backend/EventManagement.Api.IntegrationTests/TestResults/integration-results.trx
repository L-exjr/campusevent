      SELECT i."Id", i."AvailableAt", i."Bucket", i."ClaimedAt", i."CreatedAt", i."DeleteAttemptCount", i."DeletedAt", i."DeletionClaimedAt", i."DeletionClaimedBy", i."Kind", i."LastError", i."LastRetriedAt", i."LifetimeDeleteAttemptCount", i."ManualRetryCount", i."ObjectKey", i."OwnerId", i."PublicUrl", i."Status"
