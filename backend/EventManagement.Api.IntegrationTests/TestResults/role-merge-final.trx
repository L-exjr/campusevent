      Executed DbCommand (4ms) [Parameters=[@eventId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT e."Id", e."Title", e."Description", e."Date", e."Location", e."Capacity", e."Category", e."OrganizerId", u."Name", (
          SELECT count(*)::int
          FROM "EventRegistrations" AS e0
          WHERE e."Id" = e0."EventId"), e."CreatedAt", e."ImageUrl", e."IsPublished", e."Version", e."PriceMinor", e."Currency", e."Format", e."MeetingUrl", e."SalesStartsAt", e."SalesEndsAt"
