      Executed DbCommand (3ms) [Parameters=[@p0='?' (DbType = DateTime), @p1='?' (DbType = DateTime), @p2='?' (DbType = Int32), @p3='?' (DbType = Guid), @p4='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      WITH candidates AS (
          SELECT "Id"
          FROM "EmailOutboxMessages"
          WHERE ("Status" = 'Pending' AND "AvailableAt" &lt;= @p0)
             OR ("Status" = 'Processing' AND "ClaimedAt" &lt; @p1)
          ORDER BY "AvailableAt", "CreatedAt"
          FOR UPDATE SKIP LOCKED
          LIMIT @p2
      )
      UPDATE "EmailOutboxMessages" AS message
      SET "Status" = 'Processing',
          "ClaimedBy" = @p3,
          "ClaimedAt" = @p4,
          "AttemptCount" = message."AttemptCount" + 1,
          "LifetimeAttemptCount" = message."LifetimeAttemptCount" + 1
      FROM candidates
      WHERE message."Id" = candidates."Id";
