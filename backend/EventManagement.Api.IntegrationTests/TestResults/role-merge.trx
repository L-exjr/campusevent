      Executed DbCommand (3ms) [Parameters=[@email='?'], CommandType='Text', CommandTimeout='30']
      SELECT u."Id", u."AuthProvider", u."CreatedAt", u."Email", u."GoogleSubject", u."ImageObjectKey", u."ImageUrl", u."IsActive", u."IsOrganizerDirectoryVisible", u."Name", u."OrganizerBannerObjectKey", u."OrganizerBannerUrl", u."OrganizerBio", u."OrganizerFacebookUrl", u."OrganizerInstagramUrl", u."OrganizerTwitterUrl", u."OrganizerWebsiteUrl", u."PasswordHash", u."Role", u."SessionVersion"
