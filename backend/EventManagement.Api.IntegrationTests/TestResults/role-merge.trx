      Executed DbCommand (4ms) [Parameters=[@studentId='?' (DbType = Guid), @p2='?' (DbType = Int32), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id", s."RegisteredAt", s."Attended", s."Id0", s."Title", s."Description", s."Date", s."Location", s."Capacity", s."Category", s."OrganizerId", u."Name", (
