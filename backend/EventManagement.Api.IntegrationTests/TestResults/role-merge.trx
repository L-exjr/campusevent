      UPDATE "ImageUploads"
      SET "Status" = 'DeletePending', "AvailableAt" = @p0
      WHERE "Status" = 'Pending' AND "CreatedAt" &lt; @p1;
      WITH candidates AS (
          SELECT "Id"
          FROM "ImageUploads"
          WHERE ("Status" = 'DeletePending' AND "AvailableAt" &lt;= @p2)
             OR ("Status" = 'Deleting' AND "DeletionClaimedAt" &lt; @p3)
          ORDER BY "AvailableAt", "CreatedAt"
          FOR UPDATE SKIP LOCKED
          LIMIT @p4
      )
      UPDATE "ImageUploads" AS upload
      SET "Status" = 'Deleting',
          "DeletionClaimedBy" = @p5,
          "DeletionClaimedAt" = @p6,
          "DeleteAttemptCount" = upload."DeleteAttemptCount" + 1,
          "LifetimeDeleteAttemptCount" = upload."LifetimeDeleteAttemptCount" + 1
      FROM candidates
      WHERE upload."Id" = candidates."Id";
