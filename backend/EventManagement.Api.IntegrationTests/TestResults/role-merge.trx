          ("Id", "IdempotencyKey", "Kind", "AggregateId", "Status",
           "AvailableAt", "AttemptCount", "CreatedAt")
      SELECT registration."Id",
             'event-reminder:' || registration."Id"::text,
             @p0,
             registration."Id",
             'Pending',
             @p1,
             0,
             @p2
      FROM "EventRegistrations" AS registration
