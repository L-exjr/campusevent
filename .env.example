VITE_API_BASE_URL=http://localhost:5080/api
# Mock mode also requires the Vite development server; production builds ignore it.
VITE_USE_MOCK_API=false
# Google OAuth web client IDs are public identifiers; never expose a client secret here.
VITE_GOOGLE_CLIENT_ID=

# TODO(go-live): Public SEO/analytics configuration. Leave GA4 and business values blank
# until real, approved production values are available.
VITE_PUBLIC_SITE_URL=https://your-production-domain.example
VITE_GA4_MEASUREMENT_ID=
VITE_BUSINESS_NAME=
VITE_BUSINESS_URL=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_STREET_ADDRESS=
VITE_BUSINESS_LOCALITY=
VITE_BUSINESS_REGION=
VITE_BUSINESS_POSTAL_CODE=
VITE_BUSINESS_COUNTRY=
VITE_BUSINESS_OPENING_HOURS=

# Backend-only process environment. Never prefix these secrets with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=Campus Events

# Email provider: keep Mailtrap for local sandbox testing; set Gmail in production.
EMAIL_PROVIDER=Mailtrap
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
GMAIL_SENDER_EMAIL=your-address@gmail.com
GMAIL_SENDER_NAME=Campus Events
GMAIL_DAILY_WARNING_THRESHOLD=400

# Paystack hosted checkout. This is backend-only and must never use a VITE_ prefix.
PAYSTACK_SECRET_KEY=sk_test_replace-me
# Keep Paystack active until Flutterwave has passed sandbox and staging verification.
PAYMENTS_PROVIDER=Paystack
PAYMENTS_PENDING_MINUTES=15

# Flutterwave sandbox. These values are backend-only and must never use a VITE_ prefix.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-me
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-sandbox-webhook-secret

# Separate signing secret for attendee QR tickets. Keep stable after launch.
QR_SIGNING_KEY=replace-with-at-least-32-random-characters

# Private Supabase Storage bucket for generated attendee certificates.
CERTIFICATES_BUCKET=certificates
CERTIFICATE_SIGNED_URL_MINUTES=60
CERTIFICATE_TEMPLATE_VERSION=1
