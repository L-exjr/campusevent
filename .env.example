VITE_API_BASE_URL=http://localhost:5080/api
# Mock mode also requires the Vite development server; production builds ignore it.
VITE_USE_MOCK_API=false
VITE_SUPABASE_URL=
# Supabase anon/publishable keys are designed to be exposed in browser apps.
# Never put a service_role or secret key in a VITE_* variable.
VITE_SUPABASE_ANON_KEY=
